# Database
DATABASE_URL=postgres://tennis:tennis@localhost:5432/tennis_platform
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin (simple shared secret for MVP internal surfaces)
ADMIN_SECRET=change-me-in-production

# 제휴 문의 알림 (선택) — 둘 다 비어 있으면 알림 없이 DB 저장만 한다.
# 텔레그램: BotFather 토큰 + 받을 채팅 ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 임의 웹훅: 문의 JSON 을 POST 한다 (Slack incoming webhook 등)
INQUIRY_NOTIFY_WEBHOOK=

# 쿠팡 파트너스 (선택) — scripts/seed-offers.ts 가 딥링크를 만들 때만 쓴다
COUPANG_PARTNERS_ACCESS_KEY=
COUPANG_PARTNERS_SECRET_KEY=
